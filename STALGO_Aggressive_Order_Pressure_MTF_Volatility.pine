//@version=6
indicator("Aggressive Order Pressure + MTF Volatility", shorttitle="Pressure MTF", overlay=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupPressure = "Order Pressure"

pressureLen = input.int(
     10,
     "Pressure Smoothing",
     minval = 1,
     group = groupPressure)

strongPressure = input.float(
     35.0,
     "Strong Pressure Level",
     minval = 1,
     maxval = 100,
     group = groupPressure)

normalPressure = input.float(
     10.0,
     "Normal Pressure Level",
     minval = 1,
     maxval = 100,
     group = groupPressure)

groupVol = "Volatility"

atrLen = input.int(
     14,
     "ATR Length",
     minval = 2,
     group = groupVol)

volLookback = input.int(
     100,
     "Volatility Lookback",
     minval = 20,
     group = groupVol)

highZ = input.float(
     0.50,
     "HIGH Volatility Threshold",
     group = groupVol)

lowZ = input.float(
     -0.50,
     "LOW Volatility Threshold",
     group = groupVol)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ESTIMATED BUY / SELL PRESSURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float barRange =
     math.max(
         high - low,
         syminfo.mintick)

float currentVolume =
     na(volume)
     ? 0.0
     : volume


float buyVolumeRaw =
     currentVolume *
     ((close - low) / barRange)


float sellVolumeRaw =
     currentVolume *
     ((high - close) / barRange)


// Smooth pressure data

float buyVolume =
     ta.ema(
         buyVolumeRaw,
         pressureLen)

float sellVolume =
     ta.ema(
         sellVolumeRaw,
         pressureLen)

float totalEstimatedVolume =
     buyVolume + sellVolume


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PRESSURE SCORE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float pressure =
     totalEstimatedVolume > 0
     ? ((buyVolume - sellVolume) /
       totalEstimatedVolume) * 100.0
     : 0.0


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BUY / SELL PERCENTAGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float buyPercent =
     math.max(
         0.0,
         math.min(
             100.0,
             (100.0 + pressure) / 2.0))

float sellPercent =
     100.0 - buyPercent


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNED PRESSURE TEXT
// FIX FOR RUNTIME ERROR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_signedNumber(float value) =>

    string result =
         str.tostring(
             value,
             "#.0")

    if value > 0
        result := "+" + result

    result


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PRESSURE STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_pressureState(float p) =>

    string result = "NEUTRAL"

    if p >= strongPressure
        result := "STRONG BUY"

    else if p >= normalPressure
        result := "BUY"

    else if p <= -strongPressure
        result := "STRONG SELL"

    else if p <= -normalPressure
        result := "SELL"

    result


f_pressureColor(float p) =>

    color result = color.gray

    if p >= strongPressure
        result := color.lime

    else if p >= normalPressure
        result := color.green

    else if p <= -strongPressure
        result := color.red

    else if p <= -normalPressure
        result := color.rgb(
             190,
             35,
             35)

    result


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VOLATILITY ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_volatility() =>

    float atrValue =
         ta.atr(atrLen)

    float atrPercent =
         close != 0
         ? (atrValue / close) * 100.0
         : 0.0

    float avgVol =
         ta.sma(
             atrPercent,
             volLookback)

    float deviation =
         ta.stdev(
             atrPercent,
             volLookback)

    float zScore =
         na(deviation) or deviation == 0
         ? 0.0
         : (atrPercent - avgVol) /
           deviation

    [atrPercent, zScore]


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1M VOLATILITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[vol1m, z1m] =
     request.security(
         syminfo.tickerid,
         "1",
         f_volatility(),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5M VOLATILITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[vol5m, z5m] =
     request.security(
         syminfo.tickerid,
         "5",
         f_volatility(),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10M VOLATILITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[vol10m, z10m] =
     request.security(
         syminfo.tickerid,
         "10",
         f_volatility(),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VOLATILITY STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_volState(float z) =>

    string result = "MID"

    if z >= highZ
        result := "HIGH"

    else if z <= lowZ
        result := "LOW"

    result


f_volColor(float z) =>

    color result =
         color.orange

    if z >= highZ
        result :=
             color.red

    else if z <= lowZ
        result :=
             color.green

    result


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DASHBOARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table dashboard =
     table.new(
         position.bottom_right,
         3,
         7,
         border_width = 1,
         border_color =
             color.rgb(
                 70,
                 70,
                 70))


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DASHBOARD UPDATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if barstate.islast

    // HEADER

    table.cell(
         dashboard,
         0,
         0,
         "METRIC",
         bgcolor =
             color.rgb(
                 15,
                 15,
                 15),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         0,
         "VALUE",
         bgcolor =
             color.rgb(
                 15,
                 15,
                 15),
         text_color =
             color.white)

    table.cell(
         dashboard,
         2,
         0,
         "STATE",
         bgcolor =
             color.rgb(
                 15,
                 15,
                 15),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // BUY
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         1,
         "BUY",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         1,
         str.tostring(
             buyPercent,
             "#.0") + "%",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.lime)

    table.cell(
         dashboard,
         2,
         1,
         buyPercent >
         sellPercent
         ? "DOMINANT"
         : "",
         bgcolor =
             buyPercent >
             sellPercent
             ? color.rgb(
                 0,
                 105,
                 55)
             : color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // SELL
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         2,
         "SELL",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(
             sellPercent,
             "#.0") + "%",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.red)

    table.cell(
         dashboard,
         2,
         2,
         sellPercent >
         buyPercent
         ? "DOMINANT"
         : "",
         bgcolor =
             sellPercent >
             buyPercent
             ? color.rgb(
                 150,
                 25,
                 25)
             : color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // PRESSURE
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         3,
         "PRESSURE",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         3,
         f_signedNumber(
             pressure),
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             f_pressureColor(
                 pressure))

    table.cell(
         dashboard,
         2,
         3,
         f_pressureState(
             pressure),
         bgcolor =
             f_pressureColor(
                 pressure),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // 1 MIN
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         4,
         "1M VOL",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(
             vol1m,
             "#.###") + "%",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         2,
         4,
         f_volState(
             z1m),
         bgcolor =
             f_volColor(
                 z1m),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // 5 MIN
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         5,
         "5M VOL",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         5,
         str.tostring(
             vol5m,
             "#.###") + "%",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         2,
         5,
         f_volState(
             z5m),
         bgcolor =
             f_volColor(
                 z5m),
         text_color =
             color.white)


    //━━━━━━━━━━━━━━━━━━
    // 10 MIN
    //━━━━━━━━━━━━━━━━━━

    table.cell(
         dashboard,
         0,
         6,
         "10M VOL",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         1,
         6,
         str.tostring(
             vol10m,
             "#.###") + "%",
         bgcolor =
             color.rgb(
                 25,
                 25,
                 25),
         text_color =
             color.white)

    table.cell(
         dashboard,
         2,
         6,
         f_volState(
             z10m),
         bgcolor =
             f_volColor(
                 z10m),
         text_color =
             color.white)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BAR COLOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

color pressureBarColor =
     pressure >= strongPressure
     ? color.new(
         color.lime,
         65)
     : pressure <= -strongPressure
     ? color.new(
         color.red,
         65)
     : na

barcolor(
     pressureBarColor)


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     pressure >= strongPressure,
     title = "Strong Buy Pressure",
     message =
         "Strong BUY pressure detected.")

alertcondition(
     pressure <= -strongPressure,
     title = "Strong Sell Pressure",
     message =
         "Strong SELL pressure detected.")

alertcondition(
     z1m >= highZ,
     title =
         "1M High Volatility",
     message =
         "1 minute volatility is HIGH.")

alertcondition(
     z5m >= highZ,
     title =
         "5M High Volatility",
     message =
         "5 minute volatility is HIGH.")

alertcondition(
     z10m >= highZ,
     title =
         "10M High Volatility",
     message =
         "10 minute volatility is HIGH.")
